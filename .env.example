# Copy to `.env` and adjust. NEVER commit the real .env (it is git-ignored).
# ----------------------------------------------------------------------------

# --- PostgreSQL (used by the db service and composed into DATABASE_URL) ---
POSTGRES_USER=ioms
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ioms

# --- Backend ---
# In Docker Compose the host is the service name `db`. For an external/managed DB,
# set the full DATABASE_URL on the hosting platform instead.
# DATABASE_URL=postgresql+psycopg://ioms:change_me_locally@db:5432/ioms

# Comma-separated allowed CORS origins. Lock to your real frontend origin in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dashboard: a product is "low stock" when quantity_in_stock < this value.
LOW_STOCK_THRESHOLD=10

ENVIRONMENT=development

# --- Frontend (build-time) ---
# The backend base URL the React app calls. In prod this is your live backend URL.
VITE_API_URL=http://localhost:8000
